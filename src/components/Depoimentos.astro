---
const depoimentos = [
  {
    nome: "Avaliação verificada no Google",
    texto: "Um profissional maravilhosa! Abordagem perfeita, escuta ativa, conduz de forma leve cada sessão. O melhor investimento sem dúvidas nenhuma, é o cuidado da nossa saúde mental com pessoas como a Crislaine, que se dedicam a ajudar o outro verdadeira e de forma leve.",
    tempo: "Google"
  },
  {
    nome: "Avaliação verificada no Google",
    texto: "Uma psicanalista que tem um olhar carinhoso e você consegue sentir confiança.",
    tempo: "Google"
  },
  {
    nome: "Avaliação verificada no Google",
    texto: "Cris é uma excelente profissional. Sempre pontual e receptiva. Suas abordagens são assertivas e leves. Super recomendo!",
    tempo: "Google"
  }
];
---
<section class="py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-display text-2xl sm:text-3xl font-bold text-textPrimary text-center mb-4">
      O que dizem quem já passou por aqui
    </h2>
    <p class="text-textMuted text-center mb-12 font-body">
      Avaliação 5.0 ⭐ com 12 avaliações no Google
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {depoimentos.map((dep) => (
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-base/50 relative">
          <div class="flex items-center gap-1 mb-3">
            {[...Array(5)].map(() => (
              <svg class="w-4 h-4 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-textPrimary text-sm leading-relaxed mb-4 font-body">"{dep.texto}"</p>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-primary font-body">{dep.nome}</span>
            <span class="text-xs text-textMuted font-body">{dep.tempo}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

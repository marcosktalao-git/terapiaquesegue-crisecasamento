---
const passos = [
  {
    icone: "chat",
    titulo: "Conversa",
    descricao: "Espaço pra você contar o que sente, sem julgamento. Aqui sua voz é ouvida de verdade."
  },
  {
    icone: "search",
    titulo: "Descoberta",
    descricao: "Junto, a gente entende os padrões emocionais por trás do que você vive no casamento."
  },
  {
    icone: "path",
    titulo: "Plano Futuro",
    descricao: "Com base no que foi descoberto, você sai com passos práticos e claros pra seguir."
  }
];
---
<section class="py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-display text-2xl sm:text-3xl font-bold text-textPrimary text-center mb-12">
      Você terá 50 minutos de atendimento completo
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {passos.map((passo, i) => (
        <div class="text-center">
          <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center mx-auto mb-5">
            {passo.icone === "chat" && (
              <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
              </svg>
            )}
            {passo.icone === "search" && (
              <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
              </svg>
            )}
            {passo.icone === "path" && (
              <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />
              </svg>
            )}
          </div>
          <span class="text-xs font-bold text-primary uppercase tracking-widest font-body">Passo {i + 1}</span>
          <h3 class="font-display text-xl font-bold text-textPrimary mt-2 mb-3">{passo.titulo}</h3>
          <p class="text-textMuted text-sm leading-relaxed font-body max-w-xs mx-auto">{passo.descricao}</p>
        </div>
      ))}
    </div>
  </div>
</section>

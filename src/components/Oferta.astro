---
import CtaButton from './CtaButton.astro';

const inclusos = [
  "50 minutos de atendimento completo",
  "Online (por videochamada) ou presencial em Catalão - GO",
  "Sigilo total e ambiente sem julgamento",
  "Plano de ação personalizado pra sua situação",
  "Possibilidade de incluir seu parceiro na sessão"
];
---
<section id="oferta" class="py-16 px-4 sm:px-6 lg:px-8 bg-surfaceAccent">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-lg border border-base/50">
      <p class="text-xs font-bold text-primary uppercase tracking-widest text-center mb-3 font-body">Oferta de Lançamento</p>

      <h2 class="font-display text-2xl sm:text-3xl font-bold text-textPrimary text-center mb-2">
        Sessão de Descoberta
      </h2>

      <p class="text-textMuted text-center mb-6 font-body text-sm">
        Entenda a crise do seu casamento e saia com um plano pra seguir
      </p>

      <div class="text-center mb-8">
        <span class="text-textMuted line-through text-lg font-body">De R$ 297</span>
        <div class="mt-1">
          <span class="text-4xl sm:text-5xl font-bold text-primary font-display">R$ 147</span>
        </div>
        <p class="text-textMuted text-xs mt-2 font-body">ou até 12x no cartão</p>
      </div>

      <ul class="space-y-3 mb-8">
        {inclusos.map((item) => (
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-textPrimary text-sm font-body">{item}</span>
          </li>
        ))}
      </ul>

      <div class="text-center">
        <CtaButton text="Sim, Quero Agendar Minha Sessão Agora" checkoutUrl="#SUBSTITUIR_PELA_URL_DA_KIWIFY" large />
      </div>

      <p class="text-center text-xs text-textMuted mt-4 font-body">
        Após a confirmação do pagamento, você recebe o link de agendamento no WhatsApp
      </p>

      <div class="flex items-center justify-center gap-2 mt-6 pt-6 border-t border-base/50">
        <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        <span class="text-xs text-textMuted font-body">Agendamento em até 24h</span>
      </div>
    </div>
  </div>
</section>

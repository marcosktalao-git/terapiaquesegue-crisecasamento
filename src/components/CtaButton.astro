---
interface Props {
  text: string;
  checkoutUrl: string;
  large?: boolean;
}
const { text, checkoutUrl, large = false } = Astro.props;
---
<a
  href={checkoutUrl}
  target="_blank"
  rel="noopener noreferrer"
  onclick="fbq('track', 'InitiateCheckout');"
  class:list={[
    "inline-flex items-center justify-center gap-2 bg-primary text-white font-bold rounded-full transition-all hover:bg-primary/90 hover:shadow-lg cursor-pointer",
    large ? "px-8 py-4 text-lg w-full sm:w-auto" : "px-6 py-3 text-sm"
  ]}
>
  {text}
</a>

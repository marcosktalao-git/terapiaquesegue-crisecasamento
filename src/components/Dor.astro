---
const dores = [
  {
    titulo: "Brigas que se repetem sem solução",
    descricao: "As mesmas discussões voltam sempre e nada muda. Você sente que está girando em círculos."
  },
  {
    titulo: "Distância mesmo morando junto",
    descricao: "Estão na mesma casa, mas parecem estranhos. O silêncio pesa mais do que qualquer briga."
  },
  {
    titulo: "Dificuldade de conversar sem virar discussão",
    descricao: "Toda tentativa de diálogo vira conflito. Você tem medo de falar o que realmente sente."
  },
  {
    titulo: "Medo de que não tenha mais volta",
    descricao: "A dúvida se ainda é possível salvar o casamento consome seus dias e suas noites."
  }
];
---
<section class="py-16 px-4 sm:px-6 lg:px-8 bg-surfaceAccent">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-display text-2xl sm:text-3xl font-bold text-textPrimary text-center mb-12">
      Seu casamento tem passado por algo assim?
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {dores.map((dor) => (
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-base/50">
          <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-display text-lg font-bold text-textPrimary mb-2">{dor.titulo}</h3>
          <p class="text-textMuted text-sm leading-relaxed font-body">{dor.descricao}</p>
        </div>
      ))}
    </div>
  </div>
</section>
